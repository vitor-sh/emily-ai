<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>EmilyCompanion</AssemblyName>
    <RootNamespace>EmilyCompanion</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>false</ImplicitUsings>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <OutputPath>bin/$(Configuration)/</OutputPath>
    <HollowKnightRefs>/home/Hiucksam/.local/share/Steam/steamapps/common/Hollow Knight/hollow_knight_Data/Managed</HollowKnightRefs>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets/EmilyActive.png.bytes" LogicalName="EmilyCompanion.Assets.EmilyActive.png" />
    <EmbeddedResource Include="Assets/EmilyBench.png.bytes" LogicalName="EmilyCompanion.Assets.EmilyBench.png" />
    <EmbeddedResource Include="Assets/EmilyCharm.png.bytes" LogicalName="EmilyCompanion.Assets.EmilyCharm.png" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Assembly-CSharp"><HintPath>$(HollowKnightRefs)/Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="MMHOOK_Assembly-CSharp"><HintPath>$(HollowKnightRefs)/MMHOOK_Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SFCore"><HintPath>$(HollowKnightRefs)/Mods/SFCore/SFCore.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="WavLib"><HintPath>$(HollowKnightRefs)/Mods/SFCore/WavLib.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(HollowKnightRefs)/Newtonsoft.Json.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System"><HintPath>$(HollowKnightRefs)/System.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System.Core"><HintPath>$(HollowKnightRefs)/System.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System.Net.Http"><HintPath>$(HollowKnightRefs)/System.Net.Http.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(HollowKnightRefs)/UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(HollowKnightRefs)/UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
