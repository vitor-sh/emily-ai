# ─────────────────────────────────────────────────────────────────
# SEGREDOS — NUNCA subir pro GitHub
# ─────────────────────────────────────────────────────────────────
.env
.env.local
.env.*
!public-release/modelo/.env.example
# Perfil da primeira inicialização pública (normalmente fica fora do projeto).
configuracao.json
provedor.env

# ─────────────────────────────────────────────────────────────────
# KIRO GATEWAY — credenciais e estado do proxy local
#
# O .env acima já cobre kiro_gateway/.env (padrão sem barra casa em
# qualquer nível), mas credentials.json guarda o refresh token da conta
# Kiro e state.json guarda estatística de uso por conta. Nenhum dos dois
# pode ir pro GitHub.
# ─────────────────────────────────────────────────────────────────
kiro_gateway/.env
kiro_gateway/credentials.json
kiro_gateway/state.json
kiro_gateway/*.log
kiro_gateway/debug_logs/

# ─────────────────────────────────────────────────────────────────
# DADOS PESSOAIS E CACHE LOCAL gerados pela Emily
# ─────────────────────────────────────────────────────────────────

# Memória persistente — contém fatos pessoais sobre o usuário
memoria.json

# Memória unificada: ChromaDB, journal e checkpoints locais. O padrão fica em
# ~/.local/share/emily/memoria_unificada; estas regras protegem também quem
# apontar EMILY_MEMORIA_PASTA pra dentro do projeto.
memoria_unificada_dados/
.emily_memoria_unificada/
chroma.sqlite3
journal.sqlite3

# Configurações e cache do Discord (token, IDs de canal)
.emily_discord.json

# Modos configurados pelo usuário
.emily_modos.json

# Cache de speedruns/inputs gravados
.emily_speedruns.json

# Cache de apps Steam (lista de jogos da conta)
.emily_steam_applist.json

# Cache de LLM e outros caches locais
.emily_cache.json
.emily_llm_cache.json

