# Exemplo público. Nenhuma chave do autor é incluída.
# Para configurar pelo assistente, execute python emily_public.py.
# Este exemplo é referência para desenvolvedores; não precisa ser editado.
# A execução completa em máquinas limpas ainda é um gate pendente.
EMILY_USUARIO=Usuário

# >>> provedor: openai
# Endpoint e modelo devem ser fornecidos pelo usuário.
EMILY_PROVEDOR_OPENAI_BASE=https://api.openai.com/v1
EMILY_PROVEDOR_OPENAI_CHAVE=OPENAI_API_KEY
EMILY_PROVEDOR_OPENAI_MODELO=
EMILY_PROVEDOR_OPENAI_TIPO=openai
# <<< provedor: openai
EMILY_PROVEDOR_LLM=openai
OPENAI_API_KEY=

# Voz é opcional no produto público planejado; o runtime ainda será adaptado.
GROQ_API_KEY=
FISH_AUDIO_KEY=
FISH_VOICE_ID=

# Memória vetorial depende de um backend configurado; começa desabilitada.
EMILY_MEMORIA_UNIFICADA=0

# Não configurar ponte/Discord/nuvem antes de revisar autenticação e permissões.
