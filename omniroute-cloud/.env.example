# NÃO usar estes placeholders em produção. preparar.py gera os segredos.
DOMAIN=modelos.seu-dominio.com
JWT_SECRET=GERADO_PELO_PREPARADOR
API_KEY_SECRET=GERADO_PELO_PREPARADOR
STORAGE_ENCRYPTION_KEY=GERADO_PELO_PREPARADOR
STORAGE_ENCRYPTION_KEY_VERSION=v1
