# Chaves dos provedores e da Emily são cadastradas no painel via túnel SSH.
# AUTH_COOKIE_SECURE=false no Compose: painel disponível somente por HTTP
# em localhost dentro do túnel SSH. A API pública utiliza HTTPS.
