[Unit]
Description=Conexão privada do PC com a Emily na Oracle
After=network-online.target emily-gateway.service
Wants=network-online.target emily-gateway.service
StartLimitIntervalSec=0
[Service]
ExecStart=/usr/bin/ssh -4 -NT -o IPQoS=none -o ConnectTimeout=6 -o ConnectionAttempts=1 -i /home/Hiucksam/.ssh/emily-oracle-relay -o BatchMode=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=15 -o ServerAliveCountMax=2 -R 127.0.0.1:15000:127.0.0.1:5000 ubuntu@163.176.97.174
Restart=always
RestartSec=5
[Install]
WantedBy=default.target
